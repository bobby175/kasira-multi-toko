{
  "name": "kasira-multi-toko",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Kasira Multi-Toko - aplikasi kasir web multi-cabang dengan QRIS dinamis, transfer bank, layar pelanggan real-time, dan konfirmasi otomatis.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js --dev",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node scripts/test-qris.mjs && node --disable-warning=ExperimentalWarning scripts/test-notify.mjs"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "kasir",
    "cashier",
    "multi-store",
    "multi-toko",
    "qris",
    "qris-dinamis",
    "payment",
    "indonesia"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bobby175/kasira-multi-toko.git"
  },
  "bugs": {
    "url": "https://github.com/bobby175/kasira-multi-toko/issues"
  },
  "homepage": "https://github.com/bobby175/kasira-multi-toko#readme",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
